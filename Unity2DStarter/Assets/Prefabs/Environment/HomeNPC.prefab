--- !u!114 &7519297086724278328
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1989334488094869217}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 76f5a6c33542407bb2a2ec0469f67178, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Npc
  npcName: Orpheus
  dailySpeeches:
  - dialogues:
    - text: 'Orpheus: "Hi!, you are awake, you should be tired right?"'
    - text: 'Orpheus: "You did great, please take a well deserved rest, go outside
        and take a walk then you can come back" '
    - text: 'Orpheus: "You should try to check if your powers are back. try to move
        around" '
  - dialogues:
    - text: 'Orpheus: "Today is a new day, and every day is good in paradise"'
    - text: 'Orpheus: "I really hope you dont get bored, you know...."'
    - text: 'Orpheus: "Its sunny outside, is probably gonna be sunny forever..."'
    - text: 'Orpheus: "Never Mind"'
    - text: 'Orpheus: "Meow"'
  - dialogues:
    - text: 'Orpheus: "That was weird, that thing is not supposed to be here...."'
    - text: 'Orpheus: "Well its just one of them, for now....."'
    - text: 'Orpheus: "You should definetely check outside for more of them."'
    - text: 'Orpheus: "..."'
  - dialogues:
    - text: 'Orpheus: "So this thing is really falling apart huh?"'
    - text: 'Orpheus: "I gueess you can not escape like you wanted to..."'
    - text: 'Orpheus: Maybe we deserve this you know?, what we did out there...."'
  - dialogues:
    - text: 'Orpheus: "Guess this is the end"'
    - text: 'Orpheus: "I am sorry"'
    - text: 'Orpheus: "They are angry..."'
    - text: 'Orpheus: "You destroyed it all"'
    - text: 'Orpheus:  "I think something is outside waiting for you, be careful"'
  speeches:
  - dialogues:
    - text: 'Orpheus: Meow... '
  - dialogues:
    - text: 'Orpheus:  ...'
  - dialogues:
    - text: 'Orpheus: *stares at you weirdly*'
  - dialogues:
    - text: 'Orpheus:  Meow'
  - dialogues:
    - text: 'Orpheus: *Prrrrrr sounds*'
  - dialogues:
    - text: 'Orpheus:  Meow'
  - dialogues:
    - text: 'Orpheus:  *stares at you weirdly*'
  - dialogues:
    - text: 'Orpheus: *stretches*'
  - dialogues:
    - text: 'Orpheus: *Car sounds*'
  - dialogues:
    - text: 'Orpheus:  *Blinks at you*'
  - dialogues:
    - text: 'Orpheus:  "What do you want?... I mean Meow"'
  promptText: Press E to talk
